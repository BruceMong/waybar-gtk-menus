{
  "manifest_version": 3,
  "name": "Waybar PiP",
  "version": "1.0",
  "description": "Sort en Picture-in-Picture la vidéo qui joue, même quand son onglet n'est pas au premier plan. Déclenchée par le clic droit du module média de Waybar.",
  "action": {
    "default_icon": {
      "19": "assets/icon19.png",
      "38": "assets/icon38.png",
      "128": "assets/icon128.png"
    },
    "default_title": "Picture-in-Picture, onglet en arrière-plan compris (Alt+Shift+P)"
  },
  "icons": { "128": "assets/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting", "notifications"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    }
  }
}
