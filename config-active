{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "reload_style_on_change": true,
    "modules-left": [
        "hyprland/workspaces",
        "custom/chrome"
    ],
    "modules-center": [
        "clock#time"
    ],
    "modules-right": [
        "privacy",
        "group/systray",
        "group/tools",
        "custom/claude",
        "custom/dnd",
        "custom/updates",
        "systemd-failed-units",
        "group/system",
        "group/connect",
        "group/audio",
        "backlight",
        "idle_inhibitor",
        "power-profiles-daemon",
        "battery",
        "custom/power"
    ],
    "group/systray": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "tray-drawer"
        },
        "modules": [
            "custom/tray-handle",
            "tray"
        ]
    },
    "group/tools": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "tools-drawer"
        },
        "modules": [
            "custom/dots",
            "custom/toggle-info",
            "custom/keybinds"
        ]
    },
    "group/system": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "system-drawer"
        },
        "modules": [
            "cpu",
            "temperature",
            "memory",
            "disk"
        ]
    },
    "group/connect": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "connect-drawer"
        },
        "modules": [
            "network",
            "bluetooth"
        ]
    },
    "group/audio": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "audio-drawer"
        },
        "modules": [
            "pulseaudio#icon"
        ]
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "ignore-workspaces": [
            "^(1[1-9]|20)$"
        ]
    },
    "hyprland/window": {
        "max-length": 25,
        "separate-outputs": true
    },
    "clock#time": {
        "format": "󰥔 {:%H:%M}",
        "locale": "fr_FR.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "weekdays": "<span color='#fab387'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        },
        "on-click": "google-chrome-stable https://calendar.google.com"
    },
    "clock#date": {
        "format": "󰃭 {:L%a %d %b}",
        "locale": "fr_FR.UTF-8",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "weekdays": "<span color='#fab387'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        },
        "on-click": "google-chrome-stable https://calendar.google.com"
    },
    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰂂"
        ],
        "tooltip-format": "{timeTo}\nPuissance : {power:.1f} W",
        "on-click": "~/.config/waybar/battery-menu.py"
    },
    "temperature": {
        "interval": 5,
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "{icon} {temperatureC}°C",
        "format-icons": [
            "󱃃",
            "󰔏",
            "󱃂"
        ],
        "tooltip-format": "CPU (Tctl) : {temperatureC}°C"
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-len": 20,
        "max-length": 28,
        "dynamic-order": [
            "title",
            "artist"
        ],
        "player-icons": {
            "default": "󰝚",
            "chromium": "󰊯",
            "firefox": "󰈹",
            "spotify": "󰓇"
        },
        "status-icons": {
            "paused": "󰏤",
            "playing": "󰐊",
            "stopped": "󰓛"
        },
        "on-click-right": "~/.config/waybar/mpris-pip.sh",
        "tooltip-format": "{player} : {title} — {artist}\nclic G : lecture/pause | clic D : PiP | molette : piste suiv./préc."
    },
    "privacy": {
        "icon-spacing": 6,
        "icon-size": 14,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true
            },
            {
                "type": "audio-in",
                "tooltip": true
            }
        ]
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "default": "󱐋",
            "performance": "󱐋",
            "balanced": "󰗑",
            "power-saver": "󰌪"
        },
        "tooltip-format": "Profil énergie : {profile}\nclic : basculer (perf / équilibré / éco)"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Caféine ACTIVE : veille et verrouillage bloqués",
        "tooltip-format-deactivated": "Caféine inactive — clic pour bloquer la veille"
    },
    "cpu": {
        "interval": 5,
        "format": "󰻠 {usage}%",
        "tooltip-format": "{avg_frequency} GHz",
        "on-click": "~/.config/waybar/system-monitor.sh"
    },
    "memory": {
        "interval": 5,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "{used:0.1f} Go / {total:0.1f} Go",
        "on-click": "~/.config/waybar/system-monitor.sh",
        "on-click-right": "~/.config/waybar/memory-details.sh"
    },
    "disk": {
        "interval": 120,
        "path": "/",
        "format": "󰋊 {percentage_used}%",
        "tooltip-format": "{used} / {total} utilisés — {free} libres"
    },
    "systemd-failed-units": {
        "hide-on-ok": true,
        "format": "󰀪 {nr_failed}",
        "format-ok": "",
        "system": true,
        "user": true,
        "tooltip": false,
        "on-click": "~/.config/waybar/systemd-menu.py",
        "on-click-right": "~/.config/waybar/systemd-menu.py"
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid} — {signalStrength}% | {ipaddr}",
        "tooltip-format-ethernet": "{ifname} | {ipaddr}",
        "tooltip-format-disconnected": "Déconnecté",
        "on-click": "~/.config/waybar/network-menu.py"
    },
    "bluetooth": {
        "format": "",
        "format-connected": "󰂱 {device_alias:.10}",
        "format-connected-battery": "󰂱 {device_alias:.10} {device_battery_percentage}%",
        "format-disabled": "",
        "on-click": "blueman-manager",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} — {device_battery_percentage}%",
        "tooltip-format": "Bluetooth"
    },
    "pulseaudio#icon": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "pulseaudio#percentage": {
        "format": "{volume}%",
        "format-muted": "Muet",
        "on-click": "~/.config/waybar/sound-menu.py",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",
        "on-click": "~/.config/waybar/brightness-menu.py"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/tray-handle": {
        "format": "󰅁",
        "tooltip": "Icônes d'applications (survoler pour déplier)"
    },
    "custom/updates": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/updates.sh",
        "interval": 1800,
        "signal": 10,
        "on-click": "~/.config/waybar/updates.sh --menu"
    },
    "custom/chrome": {
        "format": "󰊯",
        "tooltip": "Google Chrome",
        "on-click": "setsid -f google-chrome-stable"
    },
    "custom/remote": {
        "format": "{}",
        "exec": "[ -f /tmp/remote-mode-active ] && echo '{\"text\": \"󰌘\", \"class\": \"active\"}' || echo '{\"text\": \"󰌙\", \"class\": \"inactive\"}'",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/waybar/remote-mode.sh"
    },
    "custom/ws-tens": {
        "format": "{}",
        "return-type": "json",
        "exec": "[ -f /tmp/waybar-ws-tens ] && echo '{\"text\": \"+10\", \"class\": \"active\", \"tooltip\": \"Dizaines (11-20) — clic pour revenir aux unités\"}' || echo '{\"text\": \"+10\", \"class\": \"inactive\", \"tooltip\": \"Unités (1-10) — clic pour passer en +10\"}'",
        "interval": "once",
        "signal": 7,
        "on-click": "~/.config/waybar/ws-tens-toggle.sh"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": "Power Menu",
        "on-click": "~/.config/waybar/power-menu.py"
    },
    "custom/toggle-info": {
        "format": "󰈈",
        "tooltip": "Modules waybar (cacher / afficher)",
        "on-click": "~/.config/waybar/eye.sh"
    },
    "custom/keybinds": {
        "format": "󰌌",
        "tooltip": "Raccourcis clavier (clic : consulter / réassigner)",
        "on-click": "~/.config/waybar/keybinds-menu.py"
    },
    "custom/dots": {
        "format": "⋮ <span color='#fab387'>3</span>",
        "tooltip": "3 module(s) repliés faute de place — clic pour y accéder\nmolette bas : cacher un module | molette haut : ressortir",
        "on-click": "~/.config/waybar/overflow-menu.py",
        "on-scroll-down": "~/.config/waybar/scroll-modules.sh down",
        "on-scroll-up": "~/.config/waybar/scroll-modules.sh up"
    },
    "custom/claude": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/claude-sessions.py",
        "interval": 10,
        "signal": 11,
        "on-click": "~/.config/waybar/claude-menu.py"
    },
    "custom/dnd": {
        "format": "{}",
        "exec": "$HOME/.config/waybar/notification-status-watch.sh",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "~/.config/waybar/notification-menu.py",
        "on-click-right": "~/.config/waybar/notification-menu.py"
    }
}
