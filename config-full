{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 2,
    "reload_style_on_change": true,

    "modules-left": ["ext/workspaces", "custom/ws-tens", "hyprland/window", "custom/chrome", "mpris"],
    "modules-center": [],
    "modules-right": ["custom/voice-rec", "custom/recorder", "privacy", "group/systray", "group/tools", "group/status", "group/system", "group/connect", "pulseaudio#mic", "group/audio", "backlight", "custom/caffeine", "battery", "group/datetime", "custom/power"],

    "defaults": {
        "clock": {
            "locale": "fr_FR.UTF-8",
            "tooltip-format": "<tt>{calendar}</tt>",
            "calendar": {
                "mode": "month",
                "on-scroll": 1,
                "format": {
                    "months": "<span color='#ebebf0'><b>{}</b></span>",
                    "weekdays": "<span color='#9a9aa2'><b>{}</b></span>",
                    "today": "<span color='#0a84ff'><b><u>{}</u></b></span>"
                }
            },
            "actions": {
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down"
            },
            "on-click": "~/.config/waybar/calendar-menu.py 60",
            "on-click-right": "uwsm app -t service -S both -- google-chrome-stable https://calendar.google.com"
        }
    },

    "group/systray": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "tray-drawer"
        },
        "modules": ["custom/tray-handle", "tray"]
    },

    "group/tools": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "tools-drawer"
        },
        "modules": ["custom/dots", "custom/toggle-info", "custom/keybinds"]
    },
    "group/status": {
        "orientation": "inherit",
        "modules": ["custom/calendar", "custom/claude", "custom/dnd", "custom/updates", "systemd-failed-units"]
    },
    "group/system": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "system-drawer"
        },
        "modules": ["cpu", "temperature", "memory", "disk"]
    },

    "group/connect": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "connect-drawer"
        },
        "modules": ["network", "bluetooth"]
    },

    "group/datetime": {
        "orientation": "inherit",
        "modules": ["clock#date", "clock#time"]
    },

    "group/audio": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "audio-drawer"
        },
        "modules": ["pulseaudio#icon", "pulseaudio#percentage"]
    },

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-name": true,
        "sort-by-id": false
    },

    "hyprland/window": {
        "format": "{initialClass}",
        "rewrite": {
            "google-chrome": "Google Chrome",
            "chrome-notes\\.example\\.com.*": "Notes",
            "chrome-(?!notes\\.example\\.com).*": "Chrome",
            "kitty": "Kitty",
            "cl-.*": "Claude",
            "md\\.obsidian\\.Obsidian": "Obsidian",
            "org\\.mozilla\\.Thunderbird": "Thunderbird",
            "org\\.mozilla\\.firefox": "Firefox",
            "com\\.rtosta\\.zapzap": "ZapZap",
            "com\\.github\\.fabiocolacio\\.marker": "Marker",
            "org\\.keepassxc\\.KeePassXC": "KeePassXC",
            "org\\.gnome\\.Nautilus": "Fichiers",
            "[Tt]hunar": "Fichiers",
            "[Cc]ode|[Cc]odium": "Visual Studio Code",
            "[Ss]lack": "Slack",
            "[Vv]esktop|[Dd]iscord": "Discord",
            "[Ss]potify": "Spotify",
            "com\\.obsproject\\.Studio|[Oo][Bb][Ss]": "OBS",
            "org\\.qbittorrent\\.qBittorrent|[Qq][Bb]ittorrent": "qBittorrent",
            "org\\.pulseaudio\\.pavucontrol|[Pp]avucontrol": "Son",
            "": "Bureau"
        },
        "max-length": 28,
        "separate-outputs": true
    },

    "clock#time": {
        "format": "{:%H:%M}"
    },

    "clock#date": {
        "format": "{:L%a %d %b}"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-warning": "{icon} {capacity}%",
        "format-critical": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": "",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity} % — {timeTo}\nPuissance : {power:.1f} W",
        "on-click": "~/.config/waybar/battery-menu.py"
    },

    "temperature": {
        "interval": 5,
        "hwmon-path-abs": "auto",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "states": {
            "hot": 75
        },
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "tooltip-format": "CPU (Tctl) : {temperatureC}°C"
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{player_icon} <i>{dynamic}</i>",
        "format-stopped": "",
        "dynamic-len": 16,
        "max-length": 22,
        "dynamic-order": ["title", "artist"],
        "player-icons": {
            "default": "",
            "chromium": "󰊯",
            "firefox": "󰈹",
            "spotify": "󰓇"
        },
        "status-icons": {
            "paused": "",
            "playing": "",
            "stopped": ""
        },
        "on-click": "~/.config/waybar/media-menu.py",
        "on-click-right": "~/.config/waybar/mpris-pip.sh",
        "on-scroll-up": "playerctl -p playerctld next",
        "on-scroll-down": "playerctl -p playerctld previous",
        "tooltip-format": "{player} : {title} — {artist}\nclic G : menu média | clic D : PiP | molette : piste suiv./préc."
    },

    "privacy": {
        "icon-spacing": 6,
        "icon-size": 14,
        "transition-duration": 250,
        "modules": [
            { "type": "screenshare", "tooltip": true },
            { "type": "audio-in", "tooltip": true }
        ]
    },

    "custom/caffeine": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/waybar/caffeine-status.sh",
        "interval": 60,
        "signal": 15,
        "on-click": "~/.config/waybar/caffeine-toggle.sh off"
    },

    "cpu": {
        "interval": 5,
        "states": {
            "high": 70,
            "critical": 90
        },
        "format": "",
        "format-high": " {usage}%",
        "format-critical": " {usage}%",
        "tooltip-format": "Charge : {usage} %\n{avg_frequency} GHz",
        "on-click": "~/.config/waybar/system-monitor.sh"
    },

    "memory": {
        "interval": 5,
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f} Go / {total:0.1f} Go",
        "on-click": "~/.config/waybar/system-monitor.sh",
        "on-click-right": "~/.config/waybar/memory-details.sh"
    },

    "disk": {
        "interval": 120,
        "path": "/",
        "format": " {percentage_used}%",
        "tooltip-format": "{used} / {total} utilisés — {free} libres"
    },

    "systemd-failed-units": {
        "hide-on-ok": true,
        "format": " {nr_failed}",
        "format-ok": "",
        "system": true,
        "user": true,
        "tooltip": false,
        "on-click": "~/.config/waybar/systemd-menu.py",
        "on-click-right": "~/.config/waybar/systemd-menu.py"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} — {signalStrength}% | {ipaddr}",
        "tooltip-format-ethernet": "{ifname} | {ipaddr}",
        "tooltip-format-disconnected": "Déconnecté",
        "on-click": "~/.config/waybar/network-menu.py"
    },

    "bluetooth": {
        "format": "",
        "format-connected": " {device_alias:.10}",
        "format-connected-battery": " {device_alias:.10} {device_battery_percentage}%",
        "format-disabled": "",
        "on-click": "~/.config/waybar/bluetooth-menu.py",
        "on-click-right": "blueman-manager",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} — {device_battery_percentage}%",
        "tooltip-format": "Bluetooth\nclic : appareils | clic droit : gestionnaire"
    },

    "pulseaudio#icon": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "~/.config/waybar/sound-menu.py",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "pulseaudio#percentage": {
        "format": "{volume}%",
        "format-muted": "Muet",
        "on-click": "~/.config/waybar/sound-menu.py",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": "\udb80\udf6d",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "~/.config/waybar/sound-menu.py",
        "tooltip-format": "Micro coupé — clic pour le réactiver"
    },

    "backlight": {
        "format": "{icon}",
        "tooltip-format": "Luminosité : {percent} %",
        "format-icons": [""],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",
        "on-click": "~/.config/waybar/brightness-menu.py"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/tray-handle": {
        "format": "",
        "tooltip": "Icônes d'applications (survoler pour déplier)"
    },

    "custom/calendar": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/calendar_agenda.py",
        "interval": 30,
        "signal": 14,
        "max-length": 30,
        "on-click": "~/.config/waybar/calendar_agenda.py --menu",
        "on-click-right": "uwsm app -t service -S both -- google-chrome-stable https://calendar.google.com"
    },

    "custom/updates": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/updates.sh",
        "interval": 1800,
        "signal": 10,
        "on-click": "~/.config/waybar/updates.sh --menu"
    },

    "custom/chrome": {
        "format": "󰊯",
        "tooltip": "Google Chrome",
        "on-click": "uwsm app -t service -S both -- google-chrome-stable"
    },

    "custom/ws-tens": {
        "format": "{}",
        "return-type": "json",
        "exec": "[ -f ${XDG_RUNTIME_DIR:-/tmp}/waybar-ws-tens ] && echo '{\"text\": \"+10\", \"class\": \"active\", \"tooltip\": \"Dizaines (11-20) — clic pour revenir aux unités\"}' || echo '{\"text\": \"+10\", \"class\": \"inactive\", \"tooltip\": \"Unités (1-10) — clic pour passer en +10\"}'",
        "interval": "once",
        "on-click": "~/.config/waybar/ws-tens-toggle.sh"
    },


    "custom/power": {
        "format": "",
        "tooltip": "Power Menu",
        "on-click": "~/.config/waybar/power-menu.py"
    },

    "custom/toggle-info": {
        "format": "",
        "tooltip": "Modules waybar (cacher / afficher)",
        "on-click": "~/.config/waybar/eye.sh"
    },

    "custom/keybinds": {
        "format": "",
        "tooltip": "Raccourcis clavier (clic : consulter / réassigner)",
        "on-click": "~/.config/waybar/keybinds-menu.py"
    },

    "custom/dots": {
        "format": "⋮",
        "tooltip": "Modules cachés (accès rapide)\nmolette bas : cacher un module | molette haut : ressortir",
        "on-click": "~/.config/waybar/overflow-menu.py",
        "on-scroll-down": "~/.config/waybar/scroll-modules.sh down",
        "on-scroll-up": "~/.config/waybar/scroll-modules.sh up"
    },

    "custom/claude": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/claude-sessions.py",
        "interval": 10,
        "signal": 11,
        "on-click": "~/.config/waybar/claude-menu.py"
    },

    "custom/recorder": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/waybar/recorder-status.sh",
        "restart-interval": 5,
        "on-click": "pkill wf-recorder"
    },
    "custom/voice-rec": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/waybar/voice-status.sh",
        "restart-interval": 5,
        "on-click": "~/.config/waybar/voice-recorder.sh stop",
        "on-click-right": "~/.config/waybar/voice-recorder.sh dir"
    },

    "custom/dnd": {
        "format": "{}",
        "exec": "$HOME/.config/waybar/notification-status-watch.sh",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "swaync-client --toggle-panel",
        "on-click-right": "~/.config/waybar/notification-menu.py"
    }
}
